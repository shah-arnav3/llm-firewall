<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent template for the Java collector (analysis).
  `llmfw-setup install` renders the @TOKENS@ and writes the result to
  ~/Library/LaunchAgents/dev.llmfirewall.collector.plist.
  @COLLECTOR_DIST@ is the Gradle `installDist` output, copied under the bin directory.

  ProcessType is Background with low-priority I/O and Nice 10, because detection
  latency does not matter. If the collector is down, the proxy drops and counts
  captures, and Claude is unaffected.
  Umask 63 (octal 077) makes the SQLite db, -wal and -shm files 0600.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.llmfirewall.collector</string>

  <key>ProgramArguments</key>
  <array>
    <string>@COLLECTOR_DIST@/bin/llmfw-collector</string>
    <string>--config</string>
    <string>@CONFIG@</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>JAVA_HOME</key>
    <string>@JAVA@</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>

  <key>StandardOutPath</key>
  <string>@LOGS_DIR@/collector.log</string>
  <key>StandardErrorPath</key>
  <string>@LOGS_DIR@/collector.log</string>
</dict>
</plist>
